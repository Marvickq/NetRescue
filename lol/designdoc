## 6. Data Model — `features.ts`

Single source of truth for landing card grid, features index, feature detail pages, prev/next navigation, and breadcrumbs.

```ts
export type FeatureId = 'feature-a' | 'feature-c' | 'feature-d';

export interface FeatureSection {
  id: string;                     // anchor id, e.g. 'specification'
  heading: string;                // "Specification"
  body?: string;                  // paragraph
  bullets?: string[];             // optional bullet list
  table?: {
    columns: string[];
    rows: string[][];
  };
}

export interface Feature {
  id: FeatureId;
  index: string;                  // "A" | "C" | "D"
  title: string;                  // "Hysteresis Recovery"
  tagline: string;                // landing card short desc
  heroSub: string;                // detail page subtitle
  watermark: string;              // "A" | "C" | "D"
  heroVideoUrl: string;           // which video to reuse
  highlights: string[];           // 3 bullets on the index row
  sections: FeatureSection[];     // detail page content
  researchAnchor: string[];       // anchor list
}

export const features: Feature[] = [
  { id: 'feature-a', index: 'A', /* … */ },
  { id: 'feature-c', index: 'C', /* … */ },
  { id: 'feature-d', index: 'D', /* … */ },
];

export const getFeature = (id: string) =>
  features.find(f => f.id === id);

export const getAdjacent = (id: string) => {
  const i = features.findIndex(f => f.id === id);
  return {
    prev: i > 0 ? features[i - 1] : null,
    next: i >= 0 && i < features.length - 1 ? features[i + 1] : null,
  };
};
```

