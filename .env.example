# NetRescue — environment variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+psycopg://netrescue:netrescue@localhost:5432/netrescue

# --- API ---
API_BIND_HOST=127.0.0.1
API_BIND_PORT=8000
API_SECRET_KEY=change-me-in-production

# --- TLS / mTLS ---
TLS_CA_CERT=certs/ca.crt
TLS_NODE_CERT=certs/node.crt
TLS_NODE_KEY=certs/node.key

# --- Feature flags ---
ENABLE_EMULATION=true
ENABLE_SECURITY=true

# --- PostgreSQL (Docker Compose only) ---
POSTGRES_USER=netrescue
POSTGRES_PASSWORD=netrescue
POSTGRES_DB=netrescue
